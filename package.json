{
  "name": "free-for-charity",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.34.5",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "next build",
    "preview": "pnpm exec serve out -l 3000",
    "lint": "eslint",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check-links": "node scripts/check-links.mjs",
    "og:card": "node scripts/generate-og-card.mjs",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:headed": "playwright test --headed",
    "test:smoke": "playwright test --config=playwright.smoke.config.ts",
    "check:drift": "node scripts/check-drift.mjs",
    "check:site-config": "node scripts/check-site-config.mjs",
    "check:rebrand": "node scripts/rebrand-check.mjs",
    "audit:high": "pnpm audit --prod --audit-level high",
    "prepare": "husky"
  },
  "dependencies": {
    "framer-motion": "^13.2.0",
    "lucide-react": "^1.45.0",
    "next": "^16.3.5",
    "postcss": "^8.5.28",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-icons": "^5.7.0"
  },
  "devDependencies": {
    "@axe-core/react": "^4.13.0",
    "@commitlint/cli": "^21.2.2",
    "@commitlint/config-conventional": "^21.2.2",
    "@eslint/eslintrc": "^3.3.7",
    "@jest/globals": "^30.5.1",
    "@lhci/cli": "^0.15.1",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/jest": "^30.0.0",
    "@types/node": "^26.5.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.3.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "husky": "^9.1.7",
    "jest": "^30.5.1",
    "jest-axe": "^11.0.0",
    "jest-environment-jsdom": "^30.5.1",
    "linkinator": "^8.1.0",
    "prettier": "^3.9.6",
    "serve": "^14.2.6",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3"
  },
  "pnpm": {
    "overrides": {
      "sharp": "^0.35.4",
      "browserslist": "^4.28.7",
      "postcss": "$postcss",
      "nanoid@<3.3.18": "^3.3.18"
    }
  }
}
